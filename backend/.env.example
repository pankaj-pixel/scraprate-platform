# MySQL 8+ connection used by FastAPI and Alembic.
# Copy this file to .env and replace the placeholders for your environment.
DATABASE_URL=mysql+pymysql://scraprate_user:PASSWORD@localhost:3306/scraprate
ENVIRONMENT=development
DATABASE_SSL=true
# For production, set this to the CA certificate supplied by your MySQL host.
DATABASE_SSL_CA=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Exact official MCX Bhavcopy CSV/ZIP download URL. No undocumented URL is
# assumed by the application. The host must be mcxindia.com or a subdomain.
MCX_BHAVCOPY_URL=

# Freshness: 0..PRICE_FRESH_DAYS = FRESH; through PRICE_STALE_DAYS = STALE.
PRICE_FRESH_DAYS=1
PRICE_STALE_DAYS=3
PUBLIC_SITE_URL=https://scraprate.netlify.app

# Public Urban Scrap collector. Keep an identifiable user-agent and conservative timeout.
URBAN_SCRAP_URL=https://urbanscrap.co/scrap-rates/
COLLECTOR_USER_AGENT=ScrapRate-Public-Rate-Collector/1.0 (+price-source monitoring)
COLLECTOR_TIMEOUT_SECONDS=20

# Privacy-conscious first-party traffic analytics.
ANALYTICS_ENABLED=true
# Generate a private random value of at least 24 characters in production.
ANALYTICS_HASH_SALT=development-only-change-me
# Required in production for /api/v1/admin/analytics. Never expose this publicly.
ADMIN_API_KEY=
